{
  "title": "scratchboard",
  "tickets": ".scratch/**/*.md",
  "format": "yaml-frontmatter",
  "idPattern": "^(\\d+)-",
  "lanes": [
    { "name": "Needs triage", "icon": "issue-opened", "match": { "field": "status", "equals": "needs-triage" } },
    { "name": "Needs info", "icon": "question", "match": { "field": "status", "equals": "needs-info" } },
    { "name": "Ready for agent", "icon": "workflow", "match": { "field": "status", "equals": "ready-for-agent" } },
    { "name": "Ready for human", "icon": "person", "match": { "field": "status", "equals": "ready-for-human" } },
    { "name": "Deferred", "icon": "calendar", "match": { "field": "status", "equals": "deferred" } },
    { "name": "Done", "icon": "check", "match": { "field": "status", "equals": "done" }, "collapsed": true },
    { "name": "Wontfix", "icon": "circle-slash", "match": { "field": "status", "equals": "wontfix" }, "collapsed": true }
  ],
  "facets": [
    {
      "field": "priority",
      "order": ["p0", "p1", "p2", "p3"],
      "colors": { "p0": "red", "p1": "amber", "p2": "cyan", "p3": "neutral" }
    },
    { "field": "labels" }
  ]
}
